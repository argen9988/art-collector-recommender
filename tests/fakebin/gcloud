#!/usr/bin/env bash
# 假 gcloud：依參數回固定輸出，並把每次呼叫記到 FAKE_GCLOUD_LOG
echo "$*" >> "${FAKE_GCLOUD_LOG:-/dev/null}"
args="$*"
# FAKE_GCLOUD_FAIL=<片段>：參數含這段字的呼叫一律失敗（測「gcloud 失敗不計入已完成」）
[ -n "${FAKE_GCLOUD_FAIL:-}" ] && [[ "$args" == *"$FAKE_GCLOUD_FAIL"* ]] && exit 1
case "$args" in
  "config get-value project"*) echo "${FAKE_DEFAULT_PROJECT:-(unset)}" ;;
  "projects list"*)
    [ "${FAKE_NO_PROJECTS:-0}" = "1" ] && exit 0
    printf "proj-a\t藏家推薦假專案\nproj-b\t練習假專案\nproj-c\t\n" ;;
  "services list"*"aiplatform.googleapis.com"*) [ "${FAKE_VERTEX_API:-0}" = "1" ] && echo "aiplatform.googleapis.com" ;;
  "services list"*"cloudscheduler.googleapis.com"*) [ "${FAKE_SCHEDULER_API:-0}" = "1" ] && echo "cloudscheduler.googleapis.com" ;;
  "projects describe"*) echo "123456" ;;
  # FAKE_VERTEX_ROLE：1＝回 roles/aiplatform.user，其他非 0 的值原樣當成服務帳戶的角色（例如 roles/editor）
  "projects get-iam-policy"*)
    case "${FAKE_VERTEX_ROLE:-0}" in 0) : ;; 1) echo "roles/aiplatform.user" ;; *) echo "$FAKE_VERTEX_ROLE" ;; esac ;;
  "services list"*"--project=proj-a"*) echo "run.googleapis.com" ;;
  "services list"*"--project=proj-c"*) echo "run.googleapis.com" ;;
  "run services list"*"--project=proj-a"*)
    printf "art-web\thttps://art-web-fake.a.run.app\nadmin-web\thttps://admin-web-fake.a.run.app\n" ;;
  "run services list"*"--project=proj-c"*) : ;;
  "builds list"*"--project=proj-a"*)
    printf "b-old\tproj-a_cloudbuild\tsource/old.tgz\tadmin-web\nb-new\tproj-a_cloudbuild\tsource/art.tgz\tart-web\n" ;;
  "storage cp gs://proj-a_cloudbuild/source/art.tgz "*)
    [ -n "${FAKE_SOURCE_TGZ:-}" ] && cp "$FAKE_SOURCE_TGZ" "$4" || exit 1 ;;
  "sql instances list"*"--project=proj-a"*) echo "db-1" ;;
  "sql instances describe"*"ipv4Enabled"*) echo "${FAKE_SQL_IPV4:-False}" ;;
  "sql instances describe"*"requireSsl"*) echo "True" ;;
  "sql instances describe"*"backupConfiguration"*) echo "True" ;;
  "sql instances describe"*"databaseVersion"*) echo "${FAKE_SQL_VERSION:-POSTGRES_15}" ;;
  "sql instances describe"*"settings.tier"*) echo "${FAKE_SQL_TIER:-db-f1-micro}" ;;
  "sql instances describe"*"activationPolicy"*) echo "ALWAYS" ;;
  "sql instances describe"*"privateNetwork"*) echo "${FAKE_SQL_PRIVATE:-}" ;;
  "secrets describe"*) [ "${FAKE_SECRETS_MISSING:-0}" = "1" ] && exit 1 ;;
  *) : ;;
esac
exit 0
